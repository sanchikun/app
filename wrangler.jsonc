{
  "name": "daytrade-100",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "95fee14aec1320eee618963695d2100b",
  // 画面のHTMLはWorker本体に同梱する
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daytrade",
      "database_id": "72af850d-7266-487e-99a0-f873601cd33d"
    }
  ],
  "triggers": {
    // 平日 9:00〜16:59 JST（UTC 0〜7時）に毎分。遅延データの処理のため大引け後も動かす
    // 曜日は名前で書く。Cloudflare の数字は 1 が日曜なので、"1-5" だと日〜木になり金曜に動かない
    "crons": ["* 0-7 * * MON-FRI"]
  },
  "vars": {
    // "yahoo" または "synthetic"（開発用の合成データ）
    "DATA_SOURCE": "yahoo"
  }
}
